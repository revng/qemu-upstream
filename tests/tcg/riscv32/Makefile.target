	done

.PHONY: build-xqccmp-c-tests
build-xqccmp-c-tests: build-xqccmp-c-tests-obj
	@for file in $(XQCCMP_OUT_C_OBJECT_DIR)/*; do \
		instname=$$(basename $$file); \
		echo "Linking obj for" $$instname; \
		$(LD) -T $(SRC)/mem-test-page.ld -o $(XQCCMP_OUT_C_BIN_DIR)/$$instname $$file; \
	done

